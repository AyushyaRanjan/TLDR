# Copy to .env and edit. Every variable the app reads is listed here.
# Nothing in this file is a secret by default. Do not commit a real .env.

# OpenAI-compatible endpoint. Default is a local Ollama server.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# After `make model`, switch this to tldr-qwen so the context window is 8192.
# qwen2.5:3b works without that step, but Ollama may silently truncate prompts.
LLM_MODEL=qwen2.5:3b

# Must match the model's real context. See ollama/Modelfile and docs/small-models.md.
LLM_MAX_CONTEXT_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9

# 3B on CPU does not parallelize well. 1 or 2 is the right range.
LLM_CONCURRENCY=2

# Approximate tokens (characters / 4). Keep CHUNK_TOKENS well under the context
# window. A rough scale is min(4000, LLM_MAX_CONTEXT_TOKENS * 0.2).
CHUNK_TOKENS=1500
CHUNK_OVERLAP_TOKENS=150

# Documents above either limit are refused, with a minute estimate.
MAX_PAGES=80
MAX_CHARS=400000

# Goal mode drops chunks scored below this (0-5).
GOAL_RELEVANCE_THRESHOLD=2

# Default output language. A 3B model is weaker outside English.
LANGUAGE=English
